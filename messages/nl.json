  "faq": {
    "title": "Veelgestelde vragen",
    "items": [
      {
        "q": "Hoe nauwkeurig is de vertaling?",
        "a": "Vox42 maakt gebruik van geavanceerde AI-vertaling met meer dan 95% nauwkeurigheid voor ondersteunde talen."
      },
      {
        "q": "Werkt het zonder Wi-Fi?",
        "a": "Ja, met een stabiele mobiele dataverbinding (4G/LTE of beter) werkt de vertaling net zo goed als via Wi-Fi."
      },
      {
        "q": "Hoe wordt mijn gesprek beschermd?",
        "a": "De transmissie is end-to-end versleuteld. Audiogegevens worden niet permanent opgeslagen."
      },
      {
        "q": "Kan ik Vox42 gebruiken in noodgevallen?",
        "a": "Vox42 is ontworpen voor dagelijkse communicatie. Voor medische noodgevallen raden we altijd een professionele tolk aan."
      },
      {
        "q": "Wat kost een gesprek per minuut?",
        "a": "De kosten variëren per bestemming. Met het Starter-pakket (€5) heeft u circa 30 minuten, met Standard (€15) circa 100 minuten."
      },
      {
        "q": "Verloopt mijn tegoed?",
        "a": "Nee. Opgewaardeerd tegoed verloopt nooit en blijft geldig zolang uw account actief is."
      },
      {
        "q": "Welke talen worden ondersteund?",
        "a": "Vox42 ondersteunt momenteel Duits, Engels, Frans, Italiaans, Spaans, Portugees, Pools, Turks, Nederlands, Russisch, Oekraïens en Chinees."
      },
      {
        "q": "Hoe waardeer ik tegoed op?",
        "a": "U kunt tegoed direct in de app opwaarderen via Apple Pay, Google Pay, creditcard of Stripe."
      }
    ]
  },
